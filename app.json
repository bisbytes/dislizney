{
  "expo": {
    "name": "dislizney",
    "slug": "dislizney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dislizney",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bisbytes.dislizney"
    },
    "android": {
      "package": "com.bisbytes.dislizney",
      "adaptiveIcon": {
        "backgroundColor": "#FFFD54",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "dislizney",
      "themeColor": "#FFFD54",
      "backgroundColor": "#FFF8E7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFD54",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "dislizney uses your location while the app is open to pop up fun facts when you are near a ride."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFFD54"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "dislizney uses your camera to snap photo spots while you wait in line. Photos stay on your device unless you share them.",
          "photosPermission": "dislizney can use photos from your library for your line keepsakes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Line-time storybook adventures for Walt Disney World: trivia, I Spy and challenges while you wait."
  }
}
